# 网关监听
PORT=4874
HOST=0.0.0.0

# 上游代理：本地没有的包（依赖）转发到公网镜像；纯离线内网设 0
UPSTREAM_ENABLED=1
UPSTREAM_REGISTRY=https://registry.npmmirror.com

# 写进索引 source.registry 的地址（员工机器要能访问到）
PUBLIC_REGISTRY_URL=http://192.168.1.10:4874/registry
PUBLIC_BASE_URL=http://192.168.1.10:4874

# 限制
MAX_TARBALL_BYTES=20971520
MAX_UNPACKED_BYTES=104857600
MAX_FILES=2000
